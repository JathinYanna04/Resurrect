#!/bin/sh
# Fake Android getprop for tests. Values can be overridden with MOCK_<PROP> env
# vars where dots become underscores, e.g. MOCK_ro_build_version_sdk=34.
key=$(echo "$1" | tr '.' '_')
eval "v=\${MOCK_$key-__unset__}"
[ "$v" != "__unset__" ] && { echo "$v"; exit 0; }
case "$1" in
  ro.build.version.release) echo 11 ;;
  ro.build.version.sdk) echo 30 ;;
  ro.product.manufacturer) echo ExampleCo ;;
  ro.product.model) echo "Example Tab 10" ;;
  ro.product.device) echo exampletab ;;
  ro.build.display.id) echo EXAMPLE.11.0 ;;
  ro.build.version.security_patch) echo 2023-10-05 ;;
  ro.boot.verifiedbootstate) echo orange ;;
  sys.boot_completed) echo 1 ;;
  *) echo "" ;;
esac
